# Copy to backend/.env for local dev (backend/.env is gitignored).

# Required. At least 32 characters: openssl rand -hex 32
JWT_SECRET=

# Postgres. If unset, the server tries localhost and falls back to SQLite (./liftoff.db).
# DATABASE_URL=postgres://postgres:password@localhost:5432/liftoff?sslmode=disable

# Session length for logins without "remember me" (minutes).
# JWT_EXPIRY_MINUTES=15
# JWT_REMEMBER_ME_DAYS=30

# Comma-separated origins allowed to call the API cross-origin. Leave unset when
# the frontend is served from the same origin (and in dev, where Vite proxies /api).
# CORS_ALLOWED_ORIGINS=https://liftoff.example.com

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted for client IPs
# (used by login/register rate limiting). Unset trusts none.
# TRUSTED_PROXIES=
